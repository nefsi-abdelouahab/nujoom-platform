# انسخ هذا الملف باسم .env واملأ القيم الفعلية — .env لا يجب أن يُرفع لأي مستودع Git

# رابط الاتصال بقاعدة بيانات MongoDB (محلي أو MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/nujoom-platform

# المنفذ الذي يعمل عليه الخادم
PORT=5000

# سر توقيع JWT — يجب أن يكون نصًا طويلًا وعشوائيًا في الإنتاج
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# مدة صلاحية التوكن
JWT_EXPIRES_IN=7d

# رابط الفرونت إند المسموح له بالاتصال (CORS)
CLIENT_ORIGIN=http://localhost:3000
